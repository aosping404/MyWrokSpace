/*
IKEA Style Sheet for QT Applications
基于宜家 (IKEA) 设计风格的 Qt 样式表
主色调：#0058a3 (IKEA 蓝色)
字体：Inter, Noto Sans SC, sans-serif
*/

/* 全局设置 */
QWidget {
    font-family: "Inter", "Noto Sans SC", sans-serif;
    font-size: 14px;
    color: #111111;
    background-color: #ffffff;
}

QMainWindow {
    background-color: #faf9fc;
}

/* 按钮样式 */
QPushButton {
    background-color: #0058a3;
    color: #ffffff;
    border: none;
    border-radius: 0px;
    padding: 10px 24px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #004080;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #003366;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #999999;
}

/* 次要按钮 */
QPushButton[class="secondary"] {
    background-color: #ffffff;
    color: #0058a3;
    border: 1px solid #0058a3;
}

QPushButton[class="secondary"]:hover {
    background-color: #f5f5f5;
    border-color: #004080;
}

/* 文本输入框 */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 0px;
    padding: 8px 12px;
    color: #333333;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #666666;
    background-color: #fafafa;
}

QLineEdit:disabled {
    background-color: #f5f5f5;
    color: #999999;
    border-color: #e0e0e0;
}

/* 多行文本编辑器 */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 0px;
    color: #333333;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
    padding: 8px;
}

QTextEdit:focus {
    border-color: #666666;
}

/* 数字输入框 */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 0px;
    padding: 8px;
    color: #333333;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #666666;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #f5f5f5;
    border-left: 1px solid #cccccc;
    border-top-right-radius: 0px;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #e0e0e0;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #f5f5f5;
    border-left: 1px solid #cccccc;
    border-bottom-right-radius: 0px;
    width: 20px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e0e0e0;
}

/* 下拉框 */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 0px;
    padding: 8px 12px;
    color: #333333;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #666666;
}

QComboBox:focus {
    border-color: #0058a3;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    background-color: #f5f5f5;
}

QComboBox::drop-down:hover {
    background-color: #e0e0e0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
    padding: 4px;
}

/* 复选框 */
QCheckBox {
    spacing: 8px;
    color: #111111;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cccccc;
    border-radius: 2px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #0058a3;
    background-color: #f5f5f5;
}

QCheckBox::indicator:checked {
    background-color: #0058a3;
    border-color: #0058a3;
    image: url(:/icons/dark/PNG/User interface/check_box.png);
}

QCheckBox::indicator:disabled {
    background-color: #f5f5f5;
    border-color: #e0e0e0;
}

QCheckBox:disabled {
    color: #999999;
}

/* 单选按钮 */
QRadioButton {
    spacing: 8px;
    color: #111111;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cccccc;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #0058a3;
    background-color: #f5f5f5;
}

QRadioButton::indicator:checked {
    background-color: #0058a3;
    border-color: #0058a3;
    border-width: 4px;
}

QRadioButton::indicator:disabled {
    background-color: #f5f5f5;
    border-color: #e0e0e0;
}

QRadioButton:disabled {
    color: #999999;
}

/* 进度条 */
QProgressBar {
    border: 1px solid #cccccc;
    border-radius: 0px;
    background-color: #f5f5f5;
    text-align: center;
    color: #333333;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #0058a3;
    border-radius: 0px;
}

/* 滑块 */
QSlider::groove:horizontal {
    border: 1px solid #cccccc;
    height: 6px;
    background-color: #f5f5f5;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #0058a3;
    border: 1px solid #004080;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #004080;
}

QSlider::groove:vertical {
    border: 1px solid #cccccc;
    width: 6px;
    background-color: #f5f5f5;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: #0058a3;
    border: 1px solid #004080;
    width: 18px;
    height: 18px;
    margin: 0 -6px;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background-color: #004080;
}

/* 标签 */
QLabel {
    color: #111111;
    background-color: transparent;
}

QLabel[class="secondary"] {
    color: #767676;
}

/* 分组框 */
QGroupBox {
    border: 1px solid #dfdfdf;
    border-radius: 0px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 500;
    color: #111111;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #111111;
}

/* 标签页 */
QTabWidget::pane {
    border: 1px solid #dfdfdf;
    background-color: #ffffff;
    border-radius: 0px;
}

QTabBar::tab {
    background-color: #f5f5f5;
    color: #767676;
    border: 1px solid #dfdfdf;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0058a3;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover {
    background-color: #fafafa;
    color: #333333;
}

/* 菜单栏 */
QMenuBar {
    background-color: #faf9fc;
    color: #111111;
    border-bottom: 1px solid #dfdfdf;
    padding: 4px;
}

QMenuBar::item {
    padding: 4px 8px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #f5f5f5;
    color: #0058a3;
}

QMenuBar::item:pressed {
    background-color: #e0e0e0;
}

/* 菜单 */
QMenu {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    color: #111111;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 32px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #0058a3;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

/* 工具栏 */
QToolBar {
    background-color: #faf9fc;
    border: none;
    border-bottom: 1px solid #dfdfdf;
    spacing: 4px;
    padding: 4px;
}

QToolBar::handle {
    background-color: #cccccc;
    width: 2px;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 6px;
    border-radius: 0px;
}

QToolButton:hover {
    background-color: #f5f5f5;
}

QToolButton:pressed {
    background-color: #e0e0e0;
}

/* 状态栏 */
QStatusBar {
    background-color: #faf9fc;
    border-top: 1px solid #dfdfdf;
    color: #767676;
}

QStatusBar::item {
    border: none;
    padding: 4px;
}

/* 滚动条 */
QScrollBar:vertical {
    border: none;
    background-color: #f5f5f5;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #999999;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f5f5f5;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #cccccc;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #999999;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 列表视图 */
QListView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    color: #111111;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
    outline: none;
}

QListView::item {
    padding: 6px;
    border: none;
}

QListView::item:hover {
    background-color: #f5f5f5;
}

QListView::item:selected {
    background-color: #0058a3;
    color: #ffffff;
}

/* 树形视图 */
QTreeView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    color: #111111;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
    outline: none;
}

QTreeView::item {
    padding: 4px;
    border: none;
}

QTreeView::item:hover {
    background-color: #f5f5f5;
}

QTreeView::item:selected {
    background-color: #0058a3;
    color: #ffffff;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:has-siblings:!adjoins-item {
    border-image: none;
}

QTreeView::branch:has-siblings:adjoins-item {
    border-image: none;
}

QTreeView::branch:!has-children:!has-siblings:adjoins-item {
    border-image: none;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/dark/PNG/Navigation/arrow_forward.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/dark/PNG/Navigation/arrow_down.png);
}

/* 表格视图 */
QTableView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    color: #111111;
    gridline-color: #e0e0e0;
    selection-background-color: #0058a3;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #f5f5f5;
    color: #111111;
    padding: 8px;
    border: none;
    border-right: 1px solid #dfdfdf;
    border-bottom: 1px solid #dfdfdf;
    font-weight: 500;
}

QHeaderView::section:hover {
    background-color: #e0e0e0;
}

/* 对话框 */
QDialog {
    background-color: #ffffff;
}

/* 消息框 */
QMessageBox {
    background-color: #ffffff;
}

/* 工具提示 */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #666666;
    padding: 4px 8px;
    border-radius: 2px;
}

/* 分隔符 */
QMainWindow::separator {
    background-color: #dfdfdf;
    width: 1px;
    height: 1px;
}

/* 停靠窗口 */
QDockWidget {
    background-color: #ffffff;
    border: 1px solid #dfdfdf;
    titlebar-close-icon: url(:/icons/dark/PNG/User interface/error.png);
    titlebar-normal-icon: url(:/icons/dark/PNG/User interface/settings.png);
}

QDockWidget::title {
    background-color: #f5f5f5;
    padding: 8px;
    border-bottom: 1px solid #dfdfdf;
    color: #111111;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #e0e0e0;
}

/* 分割器 */
QSplitter::handle {
    background-color: #dfdfdf;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #0058a3;
}
